{
  "name": "everywhere",
  "displayName": "EveryWhere Harness",
  "description": "Use EveryWhere Harness: autonomous AI agent directly inside Visual Studio Code sidebar and editor",
  "version": "1.2.9",
  "icon": "assets/icon/icon.png",
  "publisher": "everson-junior",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/everson-junior/DeepSeek-Harness-Everywhere.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "everywhere",
    "everywhere-harness",
    "deepseek",
    "harness",
    "agent",
    "autonomous",
    "ai assistant",
    "reasoner",
    "r1",
    "v3"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "everywhere-harness-sidebar",
          "title": "EveryWhere Harness",
          "icon": "media/everywhere.svg"
        }
      ]
    },
    "views": {
      "everywhere-harness-sidebar": [
        {
          "id": "everywhere.harnessView",
          "name": "EveryWhere Harness",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "everywhere.startHarness",
        "title": "Start Harness",
        "category": "EveryWhere Harness",
        "icon": "$(play)"
      },
      {
        "command": "everywhere.stopHarness",
        "title": "Stop Harness",
        "category": "EveryWhere Harness",
        "icon": "$(debug-stop)"
      },
      {
        "command": "everywhere.restartHarness",
        "title": "Restart Harness",
        "category": "EveryWhere Harness",
        "icon": "$(debug-restart)"
      },
      {
        "command": "everywhere.debugHarness",
        "title": "Debug Harness in Project...",
        "category": "EveryWhere Harness",
        "icon": "$(debug-alt)"
      },
      {
        "command": "everywhere.openFullView",
        "title": "Open in Editor Tab",
        "category": "EveryWhere Harness",
        "icon": "$(link-external)"
      },
      {
        "command": "everywhere.focusHarness",
        "title": "Open EveryWhere Harness Chat",
        "category": "EveryWhere Harness",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "everywhere.moveToRightSidebar",
        "title": "Move to Right Sidebar",
        "category": "EveryWhere Harness",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "everywhere.openInBrowser",
        "title": "Open in External Browser",
        "category": "EveryWhere Harness",
        "icon": "$(globe)"
      },
      {
        "command": "everywhere.showLogs",
        "title": "Show Harness Logs",
        "category": "EveryWhere Harness",
        "icon": "$(output)"
      },
      {
        "command": "everywhere.installHarness",
        "title": "Install EveryWhere Harness",
        "category": "EveryWhere Harness",
        "icon": "$(cloud-download)"
      },
      {
        "command": "everywhere.checkHarness",
        "title": "Check EveryWhere Harness Installation",
        "category": "EveryWhere Harness",
        "icon": "$(sync)"
      },
      {
        "command": "everywhere.openSettings",
        "title": "Configure Settings",
        "category": "EveryWhere Harness",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "everywhere.startHarness",
          "when": "view == everywhere.harnessView && !everywhere.isRunning",
          "group": "navigation@1"
        },
        {
          "command": "everywhere.stopHarness",
          "when": "view == everywhere.harnessView && everywhere.isRunning",
          "group": "navigation@1"
        },
        {
          "command": "everywhere.restartHarness",
          "when": "view == everywhere.harnessView && everywhere.isRunning",
          "group": "navigation@2"
        },
        {
          "command": "everywhere.debugHarness",
          "when": "view == everywhere.harnessView",
          "group": "navigation@2"
        },
        {
          "command": "everywhere.openFullView",
          "when": "view == everywhere.harnessView",
          "group": "navigation@3"
        },
        {
          "command": "everywhere.showLogs",
          "when": "view == everywhere.harnessView",
          "group": "navigation@4"
        },
        {
          "command": "everywhere.moveToRightSidebar",
          "when": "view == everywhere.harnessView",
          "group": "navigation@5"
        },
        {
          "command": "everywhere.openInBrowser",
          "when": "view == everywhere.harnessView",
          "group": "navigation@6"
        },
        {
          "command": "everywhere.openSettings",
          "when": "view == everywhere.harnessView",
          "group": "navigation@7"
        }
      ]
    },
    "configuration": {
      "title": "EveryWhere Harness",
      "properties": {
        "everywhere.dshPath": {
          "type": "string",
          "default": "",
          "description": "Custom command or path to harness executable (e.g. 'ewh', 'dsh', 'pnpm dsh', or '/path/to/bin.ts'). If empty, auto-detects from workspace or PATH."
        },
        "everywhere.projectPath": {
          "type": "string",
          "default": "",
          "description": "Project directory used as the working directory when EveryWhere Harness starts. Empty uses the first open workspace folder."
        },
        "everywhere.port": {
          "type": "number",
          "default": 0,
          "description": "Port for EveryWhere Harness Web server (0 for auto-assigned random port)."
        },
        "everywhere.profile": {
          "type": "string",
          "default": "web",
          "description": "Harness profile to run (e.g. 'web')."
        },
        "everywhere.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the EveryWhere Harness runtime when VS Code opens or the view is revealed."
        },
        "everywhere.apiKey": {
          "type": "string",
          "default": "",
          "description": "EveryWhere API Key. If blank, reads EVERYWHERE_API_KEY or DEEPSEEK_API_KEY from environment or .env."
        },
        "everywhere.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "EveryWhere API Base URL."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*.spec.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}