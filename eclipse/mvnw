#!/usr/bin/env bash
set -e

MAVEN_VERSION="3.9.6"
TARGET_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION/apache-maven-$MAVEN_VERSION"
MVN_EXEC="$TARGET_DIR/bin/mvn"

if [ ! -x "$MVN_EXEC" ]; then
    echo "[mvnw] Baixando Apache Maven $MAVEN_VERSION automaticamente..."
    mkdir -p "$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
    curl -sSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" | tar -xz -C "$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
    chmod +x "$MVN_EXEC"
fi

exec "$MVN_EXEC" "$@"
